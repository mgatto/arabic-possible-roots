{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "formatter": true,
  "lsp": {
    "ty": {
      "command": ["ty", "server"],
      "extensions": [".py", ".pyi"]
    }
  },
  "watcher": {
    "ignore": [".venv/**", "__pycache__/**", ".pytest_cache/**", "*.pyc"]
  }
}
